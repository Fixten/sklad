{
  "name": "backend",
  "scripts": {
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "start:dev": "NODE_ENV=development dotenv -e ../.env.development -- tsx watch src/index.ts",
    "generate:openapi": "tsx scripts/generateOpenApi.ts",
    "build": "pnpm generate:openapi && rm -rf build/* && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -r public build/",
    "prod": "pm2-runtime build/index.js",
    "test:watch": "jest --watch",
    "test:unit": "jest --runInBand",
    "test:e2e": "pnpm generate:openapi && jest -c jest.e2e.config.mjs --runInBand",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "typecheck": "tsc --noEmit",
    "migration:generate": "dotenv -e ../.env.development -- drizzle-kit generate",
    "migration:apply": "drizzle-kit migrate",
    "migration:apply:dev": "dotenv -e ../.env.development -- drizzle-kit migrate",
    "studio": "dotenv -e ../.env.development -- drizzle-kit studio"
  },
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "better-sqlite3": "^12.8.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pm2": "^6.0.14",
    "swagger-ui-dist": "^5.33.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jest": "^29.12.1",
    "jest": "^30.2.0",
    "prettier": "^3.8.0",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.53.0"
  }
}
