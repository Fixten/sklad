{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "paths": {
      "@/*": ["./src/*"],
      "@ui/*": ["./src/components/ui/*"],
      "@base": ["./src/components/ui/base"],
      "@base/*": ["./src/components/ui/base/*"]
    }
  },
  "isolatedModules": true,
  "esModuleInterop": true,
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    "vite.config.mts"
  ],
  "exclude": ["*/node_modules/*"]
}
