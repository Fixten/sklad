{
  "name": "sklad",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "back:dev": "pnpm --filter backend start:dev",
    "back:build": "pnpm --filter backend build",
    "back:test": "pnpm --filter backend test:all",
    "back:prod": "pnpm --filter backend run prod",
    "back:prod:local": "pnpm back:build && pnpm --filter backend run prod:local",
    "openapi:generate": "pnpm --filter backend generate:openapi",
    "migrate": "pnpm --filter backend migration:apply",
    "migrate:dev": "pnpm --filter backend migration:apply:dev",
    "front:dev": "pnpm --filter frontend dev",
    "front:test": "pnpm --filter frontend test",
    "front:test:browser": "pnpm --filter frontend test:browser",
    "front:build": "pnpm --filter frontend build",
    "front:prod": "pnpm --filter frontend run prod",
    "prepare": "husky",
    "lint:staged": "lint-staged",
    "front:api": "openapi-typescript ./backend/public/spec.json -o ./frontend/src/api/schema.d.ts"
  },
  "dependencies": {
    "@tsconfig/recommended": "^1.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "husky": "9.1.7",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
